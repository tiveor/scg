{
  "name": "express-route",
  "description": "Express REST resource: router, controller and service",
  "engine": "EJS",
  "templateDir": ".",
  "outputDir": "src/routes/{{name:kebab}}",
  "prompts": [
    {
      "name": "name",
      "type": "text",
      "message": "Resource name (singular, e.g. user)",
      "positional": true,
      "required": true,
      "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$"
    }
  ],
  "structure": [
    { "template": "routes.ejs", "output": "{{name:kebab}}.routes.ts" },
    { "template": "controller.ejs", "output": "{{name:kebab}}.controller.ts" },
    { "template": "service.ejs", "output": "{{name:kebab}}.service.ts" }
  ]
}
