{
  "name": "react-component",
  "description": "React component (TSX) with optional CSS module and test",
  "engine": "EJS",
  "templateDir": ".",
  "outputDir": "src/components/{{name:pascal}}",
  "prompts": [
    {
      "name": "name",
      "type": "text",
      "message": "Component name",
      "positional": true,
      "required": true,
      "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$"
    },
    { "name": "cssModule", "type": "confirm", "message": "Add a CSS module?", "default": true },
    { "name": "withTest", "type": "confirm", "message": "Add a test (Testing Library)?", "default": true }
  ],
  "structure": [
    { "template": "component.ejs", "output": "{{name:pascal}}.tsx" },
    { "template": "styles.ejs", "output": "{{name:pascal}}.module.css", "when": "cssModule" },
    { "template": "test.ejs", "output": "{{name:pascal}}.test.tsx", "when": "withTest" },
    { "template": "index.ejs", "output": "index.ts" }
  ]
}
